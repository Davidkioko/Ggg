log = logging.getLogger("vipbot")async def safe_call(fn, *args, retries=3, **kwargs):
    for i in range(retries):
        try:
            return await fn(*args, **kwargs) 
        except Exception as e:
            log.error(f"Attempt {i+1}/{retries} failed: {e}")
            if i < retries - 1:                
                await asyncio.sleep(2 ** i + random.uniform(0, 1)) # 1s-2s, 2s-3s, 4s-5s non-blocking
    log.error(f"All {retries} attempts failed for {fn.__name__}")
    return None 
async def retry_with_jitter(fn, *args, max_attempts=3, **kwargs): # FIX B1
    for i in range(max_attempts):
        try:
            return await fn(*args, **kwargs)
        except Exception:
            if i == max_attempts-1: raise
            await asyncio.sleep((2**i) + random.uniform(0.1, 0.5))
    return None
