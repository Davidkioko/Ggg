+# Thin compatibility shim. All real definitions live in modules.config_loader.
+# Existing "from config import X" / "import config" statements continue to work.
+# The single runtime-mutable flag (SYSTEM_LOCKED) is kept in lock-step by a
+# custom ModuleType so every attribute write is visible in both namespaces.
+# No other names are mutable at runtime.
+import sys
+import types
+import modules.config_loader as _real
+
+class _ConfigModule(types.ModuleType):
+    def __getattr__(self, name):
+        return getattr(_real, name)
+
+    def __setattr__(self, name, value):
+        if name == "SYSTEM_LOCKED":
+            # Keep both namespaces identical for the single mutable flag.
+            object.__setattr__(self, name, value)
+            setattr(_real, name, value)
+        else:
+            # All other names are read-only from the shim's point of view;
+            # forward to the real module so accidental writes are visible.
+            setattr(_real, name, value)
