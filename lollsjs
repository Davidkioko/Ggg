                        if not u_new or u_new.referred_by is not None:
                            return False
                        u_owner = await db.get(User, owner_id, with_for_update=True)
                        if not u_owner or u_owner.referral_earned_today >= daily_cap:
                            return False

                        # Set referrer
                        await db.execute(update(User).where(User.uid == new_user_id).values(referred_by=owner_id))

                        # FIX #OCC5 + FIX #LIVE2: OCC loop for referral token credit
                        for occ_attempt in range(OCC_RETRIES): # FIX #MITA-5.2: was 5 hardcoded
                            if occ_attempt == OCC_RETRIES - 1: # FIX #LOG3
                                logger.warning("OCC contention: credit_referral final retry attempt=%s for owner_id=%s new_user_id=%s", occ_attempt, owner_id, new_user_id)

                            res_ver = await db.execute(
                                select(User.balance_version).where(User.uid == owner_id).with_for_update()
                            )
                            row = res_ver.first()
                            if not row: break
                            expected_version = row[0]

                            stmt = (
                                update(User)
                  .where(
                                    User.uid == owner_id,
                                    User.referral_earned_today < daily_cap,
                                    User.balance_version == expected_version
                                )
                  .values(
                                    tokens=User.tokens + reward,
                                    balance_version=User.balance_version + 1, # FIX #OCC5
                                    referral_earned_today=User.referral_earned_today + 1,
                                    lifetime_referral_tokens=User.lifetime_referral_tokens + reward
                                )
                            )
                            res = await db.execute(stmt)
                            if res.rowcount == 1:
