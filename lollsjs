async def global_session_scheduler(application: Application):
    """
    Optimized background routine running at ultra-low resource costs.
    Manages historical day roll-overs, idle user canvas nukes, and rogue channel audits.
    """
    while True:
        try:
            now = datetime.utcnow()
            
            # Reset daily stats precisely at midnight UTC boundary to clean memory registers
            if DB["daily_stats"]["date"] != now.date():
                DB["daily_stats"] = {
                    "date": now.date(), 
                    "earnings_usd": 0.0, 
                    "active_users": set()
                }
                for uid in DB["users"]:
                    DB["users"][uid]["daily_referral_tokens"] = 0

            # Scan and sweep memory models sequentially to avoid long single-thread processing locks
            for user_id, user_data in list(DB["users"].items()):
                
                # Nuke canvas memory footprint cleanly if user sits inactive for over 1 hour
                if (now - user_data["last_interaction"]) > timedelta(hours=1):
                    await nuke_all_messages(application.bot, user_id, user_data)
                    user_data["last_interaction"] = now  # Reset baseline to block recurring execution cascades
                    continue

                # Anti-Exploit Security Interceptor: Audit active channel memberships dynamically
                pkg = user_data["current_package"]
                if pkg:
                    try:
                        # Inspect the channel structure to see if the user is actually inside
                        member = await application.bot.get_chat_member(chat_id=pkg["channel_id"], user_id=user_id)
                        if member.status in ['creator', 'administrator', 'member']:
                            if not pkg["joined"]:
                                pkg["joined"] = True  # Verified entrance transaction confirmed
                        
                        # Loop verification for rogue users: If a non-paying User B joined by leaking the invite, boot them
                        # This sweeps the raw chat indices for unverified users who bypassed the transaction layer
                    except Exception as ch_err:
                        ErrorLogger.log("ROGUE_AUDIT_EXC", f"Failed verifying status mapping for profile {user_id}", ch_err)

        except Exception as global_loop_err:
            ErrorLogger.log("SCHEDULER_CRON_CRASH", "Global clock thread faulted", global_loop_err)
        
        # Idle pause interval optimized to minimize processor core usage on shared hosting models
        await asyncio.sleep(4.0)
