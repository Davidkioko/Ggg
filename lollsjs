async def _safe_send(client, chat_id, *args, **kwargs):
    try:
        async with tg_semaphore:
            if kwargs.pop("photo", False):
                return await client.send_photo(chat_id, *args, **kwargs)
            else:
                return await client.send_message(chat_id, *args, **kwargs)
    finally:
        await asyncio.sleep(SEND_SLEEP)

async def batch_delete_messages(client, chat_id, msg_ids):
    if not msg_ids: return
    chunks = [msg_ids[i:i+100] for i in range(0, len(msg_ids), 100)]
    for chunk in chunks:
        async with tg_semaphore:
            try:
                await client.delete_messages(chat_id, chunk)
            except: pass
        await asyncio.sleep(SEND_SLEEP)

def gate_guard(func):
    async def wrapper(client, query: CallbackQuery):
        uid = query.from_user.id
        if not await check_gate(client, uid):
            async with SessionLocal() as db:
                async with db.begin(): # FIX #16 + #36: atomic Tx
                    u = await db.get(User, uid)
                    if u and u.menu_msg_ids:
                        loop = asyncio.get_running_loop()
                        ids = await loop.run_in_executor(None, json.loads, u.menu_msg_ids)
                        if ids: _PENDING_DELETE[uid] = _PENDING_DELETE.get(uid, []) + ids
                        u.menu_msg_ids = json.dumps([])
                    await set_state(uid, "main", db=db) # FIX #A33: now inside TX
            try:
                async with tg_semaphore:
                    await query.message.delete()
            except: pass
            await _safe_send(client, query.message.chat.id, "You left the required channel. Join to continue")
            bal = await get_balance(uid)
            msg = await _safe_send(client, uid, f"**Balance:** {bal} tokens", reply_markup=main_menu(bal), photo=False)
            return
        return await func(client, query)
    return wrapper

async def vanish_and_send(client, query, photo_key, caption, markup):
    uid = query.from_user.id
    now = time.time()
    last_ts = _MENU_COALESCE.get(uid, 0)
    if now - last_ts < 1.0:
        return
    _MENU_COALESCE[uid] = now
    async with SessionLocal() as db:
        async with db.begin(): # FIX #16 + #36: atomic Tx
            u = await db.get(User, uid)
            if u and u.menu_msg_ids:
                loop = asyncio.get_running_loop()
                ids = await loop.run_in_executor(None, json.loads, u.menu_msg_ids)
                if ids: _PENDING_DELETE[uid] = _PENDING_DELETE.get(uid, []) + ids
                u.menu_msg_ids = json.dumps([])
    try:
        async with tg_semaphore:
            await query.message.delete()
    except: pass
    gif = await get_gif(photo_key)
    msg = await _safe_send(client, uid, caption, reply_markup=markup, photo=False)
    async with tg_semaphore:
        await client.send_animation(uid, gif, caption=caption, reply_markup=markup)
    return msg

