        except Exception as e:
            await _safe_send(client, m.chat.id, f"Failed to post: {e}")
        return
    else:
        msg = parts[1]

    # FIX #58: Get all UIDs in one atomic TX first
    uids = []
    async with SessionLocal() as db:
        async with db.begin(): # atomic read TX
            stmt = select(User.uid)
            res = await db.execute(stmt)
            uids = [row[0] for row in res.fetchall()]

    # TG IO only after TX commits
    count = 0
    for uid in uids:
        await _safe_send(client, uid, msg)
        count += 1
        if count % 20 == 0: await asyncio.sleep(0.1)

    await _safe_send(client, m.chat.id, f"Posted to {count} users")
