async def _reset_stuck_jobs(db): # FIX #35: use parent db, no internal begin
    await db.execute(
        update(WebhookJob)
       .where(
            WebhookJob.status=="processing",
            exists().where(
                Payment.invoice_id == WebhookJob.invoice_id,
                Payment.processed_job_id == WebhookJob.id
            )
        )
       .values(status="pending")
    )
    await db.execute(
        update(WebhookJob)
       .where(WebhookJob.status=="processing", WebhookJob.created < func.now() - func.make_interval(secs=300))
       .values(status="pending")
    )

async def _cleanup_old_jobs(db): # FIX #35: use parent db, no internal begin
    await db.execute(
        update(WebhookJob)
       .where(WebhookJob.status=="done", WebhookJob.created < func.now() - func.make_interval(secs=86400))
       .values(status="done")
    )

async def _enqueue_job(uid: int, tokens: int, invoice_id: str, db):
    stmt = pg_insert(WebhookJob).values(
        uid=uid, tokens=tokens, invoice_id=invoice_id, status="pending"
    ).on_conflict_do_nothing(
        index_elements=['invoice_id']
    ).returning(WebhookJob.id)
    res = await db.execute(stmt)
    job_id = res.scalar_one_or_none()
    return job_id

