async def retry_with_jitter(fn, *args, max_attempts=3, **kwargs):
    for i in range(max_attempts):
        try:
            return await fn(*args, **kwargs)
        except Exception:
            if i == max_attempts-1: raise
            await asyncio.sleep((2**i) + random.uniform(0.1, 0.5)) # jitter
    return None
# END PART

