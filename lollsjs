# PART: UID_SERIALIZATION
# HEADER: FIX #QUEUE1 + FIX #QUEUE_SHARED Canonical global per-uid lock. Other modules must import _get_uid_lock from here to ensure only one add/deduct/activate/credit runs at a time for the same uid across all modules
_uid_locks: dict[int, asyncio.Lock] = {}
_global_lock = asyncio.Lock()

async def _get_uid_lock(uid: int) -> asyncio.Lock:
    async with _global_lock:
        if uid not in _uid_locks:
            _uid_locks[uid] = asyncio.Lock()
        return _uid_locks[uid]
# END PART

