@app.on_message(filters.command("post") & filters.user(ADMIN_IDS))
async def post_cmd(client, m: Message):
    parts = m.text.split(" ", 2)    
    if len(parts) == 1:
        msg = DEFAULT_POST
    elif len(parts) == 3 and parts[1].startswith("-100"):
        channel_id = int(parts[1])
        msg = parts[2]
        try:
            await _safe_send(client, channel_id, msg)
