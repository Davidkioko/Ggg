# PART: JOB_STALE_CHECK
# HEADER: FIX #D1 Helper to check if a job is stale so we can allow takeover
async def _job_is_stale(db: AsyncSession, job_id: int) -> bool:
    if job_id is None:
        return True
    res = await db.execute(select(WebhookJob.status).where(WebhookJob.id == job_id))
    status = res.scalar_one_or_none()
    return status in (None, "done", "failed") # allow takeover
# END PART

# PART: ADD_TOKENS_ATOMIC
# HEADER: FIX #A Claim job_id first before touching tokens. User upsert + Payment update commit together or roll back 100%
# HEADER: FIX #B1 Idempotent to same job_id: allow claim if processed_job_id is NULL or already this job_id
# HEADER: FIX #D1 Single source of truth for claiming. Allow steal if previous job is stale
# HEADER: FIX #OCC1 Use balance_version OCC. Read version, update with version check, retry if rowcount 0
# HEADER: FIX #OCC2 If user missing, INSERT with balance_version=1 to start OCC chain
# HEADER: FIX #LIVE2 Use OCC_RETRIES with module-specific backoff 0.02-0.06*(2^attempt) to break livelock with activate_package/credit_referral
# HEADER: FIX #BURST1 Outer retry loop now also retries on False from OCC exhaustion to reduce burst failures
# HEADER: FIX #LOG1 Log final OCC retry attempt for contention visibility
# HEADER: FIX #QUEUE1 Wrapped in per-uid lock to make OCC exhaustion impossible
# HEADER: FIX #MITA-2.1 Lock order: TX first, then uid_lock
async def _add_tokens_inner(uid, amount, payment_id: int = None, job_id: int = None, db: AsyncSession = None):
    """Inner logic. Assumes caller already set SERIALIZABLE isolation."""
    assert db is not None, "add_tokens requires external db session"

    now = datetime.now(timezone.utc)

    if payment_id is not None:
        # FIX #144: Lock both Payment and User before doing anything
        stmt_lock_payment = select(Payment).where(Payment.id == payment_id).with_for_update()
        result_lock_p = await db.execute(stmt_lock_payment)
        payment = result_lock_p.scalar_one_or_none()
        if payment is None:
            return False

        # FIX #B1 + FIX #D1: Claim job_id first to prevent double processing on recovery
        if job_id is not None:
            res_claim = await db.execute(
                update(Payment)
     .where(Payment.id == payment_id)
     .where(or_(Payment.processed_job_id.is_(None), Payment.processed_job_id == job_id))
     .values(processed_job_id=job_id)
            )
            if res_claim.rowcount == 0:
                res_current = await db.execute(select(Payment.processed_job_id).where(Payment.id == payment_id))
                current_job = res_current.scalar_one_or_none()
                if await _job_is_stale(db, current_job):
                    await db.execute(
                        update(Payment).where(Payment.id == payment_id).values(processed_job_id=job_id)
                    )
                else:
                    if payment.paid and payment.tokens_credited:
                        return True
                    return False

        if payment.paid or payment.tokens_credited:
            return True

    # FIX #OCC1 + FIX #OCC2 + FIX #LIVE2: OCC loop for balance update, with INSERT fallback
    for attempt in range(OCC_RETRIES): # FIX #MITA-5.2: was hardcoded 5
        if attempt == OCC_RETRIES - 1: # FIX #LOG1
            logger.warning("OCC contention: _add_tokens_inner final retry attempt=%s for uid=%s amount=%s", attempt, uid, amount)

        res_user = await db.execute(select(User.balance_version).where(User.uid == uid).with_for_update())
        row = res_user.first()

        if row is None:
            # FIX #OCC2: User does not exist. INSERT with version 1
            stmt_ins = insert(User).values(uid=uid, tokens=amount, balance_version=1)
            result = await db.execute(stmt_ins)
            if result.rowcount == 1:
                break
            # race on insert, retry and read again
            await asyncio.sleep(random.uniform(0.02 * (2 ** attempt), 0.06 * (2 ** attempt))) # FIX #LIVE2: module-specific range
            continue
        else:
            expected_version = row[0]
            stmt = (
                update(User)
     .where(User.uid == uid, User.balance_version == expected_version)
     .values(
                    tokens=User.tokens + amount,
                    balance_version=User.balance_version + 1
                )
            )
            result = await db.execute(stmt)
            if result.rowcount == 1:
                break
            # rowcount 0 means someone changed version, re-read and retry
            await asyncio.sleep(random.uniform(0.02 * (2 ** attempt), 0.06 * (2 ** attempt))) # FIX #LIVE2
    else:
        # Could not update after retries
        return False

    if payment_id is not None:
        await db.execute(
            update(Payment)
 .where(Payment.id == payment_id)
 .values(
                paid=True,
                tokens_credited=True,
                credited_at=now,
                state='paid'
            )
        )

    return True
# END PART

# HEADER: FIX #STARVE1 Bump outer attempts to OCC_RETRIES. FIX #BURST1 Retry on False from inner OCC exhaustion
# HEADER: FIX #JITTER1 Add jitter on every outer retry, not just 40001
# HEADER: FIX #QUEUE1 Acquire per-uid lock for full duration to prevent concurrent add/deduct
# HEADER: FIX #MIT1 Use reserving state for admin payments
# HEADER: FIX #MITA-2.1 Lock order: TX first, then uid_lock
async def add_tokens(uid, amount, payment_id: int = None, job_id: int = None, db: AsyncSession = None, reason: str = 'payment'):
    if payment_id is not None and db is None:
        raise ValueError("add_tokens requires external db session when payment_id is provided")

    own_session = False
    if db is None:
        own_session = True
        db = SessionLocal()

    max_attempts = OCC_RETRIES # FIX #MITA-5.2: was 5 hardcoded
    for attempt in range(max_attempts):
        # FIX #JITTER1: jitter before each retry attempt > 0
        if attempt > 0:
            await asyncio.sleep(random.uniform(0.03, 0.10))
        try:
            async with db.begin(): # FIX #MITA-2.1: TX first
                uid_lock = await _get_uid_lock(uid)
                async with uid_lock: # FIX #MITA-2.1: then lock
                    await db.execute(select(1).execution_options(isolation_level="SERIALIZABLE"))

                    if payment_id is None and reason == 'admin':
                        stmt_payment = insert(Payment).values(
                            uid=uid,
                            amount_usd=0,
                            tokens=amount,
                            paid=False,
                            tokens_credited=False,
                            credited_at=None,
                            client_ref=f'admin_add_{uuid.uuid4().hex}',
                            processed_job_id=None,
                            state='reserving' # FIX #MIT1: was 'pending'
                        ).returning(Payment.id)
                        res_payment = await db.execute(stmt_payment)
                        payment_id = res_payment.scalar_one()

                    res = await _add_tokens_inner(uid, amount, payment_id, job_id, db)
                    if res:
                        return True
                    # FIX #BURST1: retry whole op on OCC exhaustion, with jitter
                    if attempt < max_attempts - 1:
                        await asyncio.sleep(random.uniform(0.03, 0.10))
                        continue
                    return False
        except DBAPIError as e:
            if attempt == max_attempts - 1:
                raise
            if getattr(e.orig, 'pgcode', None) == '40001':
                await asyncio.sleep(random.uniform(0.02, 0.08))
                continue
            # FIX #JITTER1: jitter for any other retryable DBAPIError before re-raising outer loop
            await asyncio.sleep(random.uniform(0.02, 0.08))
            continue
    return False

# PART: DEDUCT_TOKENS_ATOMIC
# HEADER: FIX #OCC1 Use balance_version OCC to prevent race with concurrent adds
# HEADER: FIX #LIVE2 Use OCC_RETRIES with module-specific backoff to avoid livelock
# HEADER: FIX #LOG1 Log final OCC retry attempt for contention visibility
# HEADER: FIX #QUEUE1 Wrapped in per-uid lock to make OCC exhaustion impossible
# HEADER: FIX #MITA-2.1 Lock order: TX first, then uid_lock
async def deduct_tokens(uid, amount, idempotency_key: str = None, db: AsyncSession = None):
    own_session = False
    if db is None:
        own_session = True
        db = SessionLocal()

    max_attempts = OCC_RETRIES # FIX #MITA-5.2
    for attempt in range(max_attempts):
        try:
            async with db.begin(): # FIX #MITA-2.1: TX first
                uid_lock = await _get_uid_lock(uid)
                async with uid_lock: # FIX #MITA-2.1: then lock
                    await db.execute(select(1).execution_options(isolation_level="SERIALIZABLE"))

                    if attempt == max_attempts - 1: # FIX #LOG1
                        logger.warning("OCC contention: deduct_tokens final retry attempt=%s for uid=%s amount=%s", attempt, uid, amount)

                    res_user = await db.execute(select(User.balance_version, User.tokens).where(User.uid == uid).with_for_update())
                    row = res_user.first()
                    if not row:
                        return False
                    expected_version, current_tokens = row
                    if current_tokens < amount:
                        return False

                    stmt = (
                        update(User)
             .where(User.uid == uid, User.balance_version == expected_version, User.tokens >= amount)
             .values(
                            tokens=User.tokens - amount,
                            balance_version=User.balance_version + 1
                        )
                    )
                    result = await db.execute(stmt)
                    if result.rowcount == 1:
                        return True
                    await asyncio.sleep(random.uniform(0.02 * (2 ** attempt), 0.06 * (2 ** attempt))) # FIX #LIVE2
        finally:
            if own_session:
                await db.close()
    return False

