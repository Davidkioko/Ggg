# PART: WEBHOOK_ALBY_ATOMIC
# HEADER: FIX #2PC-WH Webhook never writes payments. Only INSERT WebhookJob. 26 is sole writer per 1.1
# HEADER: FIX #B2 Claim idempotent to same job_id: allow if processed_job_id NULL or already this job_id
# HEADER: FIX #D2 Single source of truth for paid state is tokens module
# HEADER: FIX #E1 Remove claim from webhook. Enqueue job and let add_tokens own the claim to prevent stuck jobs
# HEADER: FIX #QUEUE4 Serialize webhook per uid: TX first, then uid_lock per 2.1
# HEADER: FIX #MIT1C Fallback lookup uses state != 'paid' to allow dead rows per 3.2
# HEADER: FIX #MIT1-3 Return 200 immediately if fallback finds state='open' per MITIGATION 1 #3
# HEADER: FIX #MIT1-4 Remove 409. Rely on add_tokens idempotency per M1 item 4
# HEADER: FIX #MITA-1.1 Webhook does not call add_tokens. Enqueue only per Mitigation A 1.1
async def alby_webhook(request):
    if not WEBHOOK_SECRET:
        return web.Response(status=500, text="WEBHOOK_SECRET not configured")
    signature = request.headers.get("X-Alby-Signature")
    if not signature:
        return web.Response(status=401, text="missing signature")
    body = await request.read()
    expected = hmac.new(WEBHOOK_SECRET.encode(), body, hashlib.sha256).hexdigest()
    if not hmac.compare_digest(signature, expected):
        return web.Response(status=401, text="invalid signature")
    data = json.loads(body)
    if data.get("event")!= "invoice.paid":
        return web.Response(text="ignored")
    invoice_id = data["data"]["id"]
    amount_usd = float(data["data"]["amount"])
    client_ref = data["data"].get("metadata", {}).get("client_ref")
    tokens_to_credit = int(round(amount_usd * TOKENS_PER_USD))
    pay_id = None
    uid = None

    async with SessionLocal() as db:
        try:
            async with db.begin(): # FIX #MITA-2.1: TX first
                # 1. Try direct lookup by invoice_id
                res_lock = await db.execute(
                    select(Payment).where(Payment.invoice_id == invoice_id).with_for_update()
                )
                pay_locked = res_lock.scalar_one_or_none()

                # 2. FIX #MITA-1.1 + 3.2: Fallback lookup by client_ref, NO UPDATE. Only read. state != 'paid'
                if not pay_locked and client_ref:
                    res_fallback = await db.execute(
                        select(Payment).where(
                            Payment.client_ref == client_ref,
                            Payment.state != 'paid' # FIX #MITA-3.2: allow dead/reserving/open
                        ).with_for_update()
                    )
                    pay_locked = res_fallback.scalar_one_or_none()
                    if not pay_locked:
                        return web.Response(status=409, text="unknown client_ref")

                uid = pay_locked.uid
                pay_id = pay_locked.id

                uid_lock = await _get_uid_lock(uid) # FIX #MITA-2.1: then lock
                async with uid_lock:
                    job_id = await _enqueue_job(pay_locked.uid, tokens_to_credit, invoice_id, db)
                    if job_id is None:
                        # FIX #MIT1-4: Already enqueued. Return 200. Idempotency handled in add_tokens
                        return web.Response(status=200, text="ok")

                    # FIX #MITA-1.1: REMOVED direct add_tokens call. 26.recover_missing_webhook_jobs is sole writer
                    await notify_user(pay_locked.uid, tokens_to_credit, db=db)
        except Exception:
            await db.rollback()
            raise
    asyncio.create_task(_send_notify_messages(uid, tokens_to_credit))
    return web.Response(status=200, text="ok")
# END PART

async def start_webhook_server():
    app_web = web.Application(client_max_size=1024*1024, client_max_timeout=WEBHOOK_TIMEOUT)
    app_web.router.add_post("/alby-webhook", alby_webhook)
    async def on_shutdown(app):
        await close_http()
    app_web.on_shutdown.append(on_shutdown)
    runner = web.AppRunner(app_web)
    await runner.setup()
    site = web.TCPSite(runner, "0.0.0.0", 8080)
    await site.start()
    print("[MODULE 23 - WEBHOOK_SERVER] Loaded v1.3.71")
