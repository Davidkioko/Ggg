# ==========================================
def main():
    # Insert your absolute core access token provided directly by Telegram's @BotFather
    BOT_TOKEN = "YOUR_TELEGRAM_BOT_TOKEN_HERE"

    app = Application.builder().token(BOT_TOKEN).build()

    # Route maps for standard clients
    app.add_handler(CommandHandler("start", start_command))
    app.add_handler(CallbackQueryHandler(handle_callbacks))
    
    # Route maps for administrative control tunnels
    app.add_handler(CommandHandler("setgate", admin_set_gate))
    app.add_handler(CommandHandler("setpremium", admin_set_premium))
    app.add_handler(CommandHandler("addtoken", admin_add_token))
    app.add_handler(CommandHandler("earnings", admin_earnings))
    app.add_handler(CommandHandler("post", admin_post))

    # Mount the low-overhead background engine chron loops to the running loop
    loop = asyncio.get_event_loop()
    loop.create_task(global_session_scheduler(app))

    logger.info("⚡ Bot core assembly complete. Low-overhead engine now deployed live.")
    app.run_polling()

if __name__ == "__main__":
    main()

