async def reconcile_reserving_payments(db=None):
    from config import RESERVING_TIMEOUT_SEC
    own_db = False
    if db is None:
        db = SessionLocal()
        own_db = True
    try:
        async with db.begin():
            stmt = text(f"""
                SELECT id, client_ref FROM payments
                WHERE state = 'reserving' AND invoice_id IS NULL
                AND created < now() - interval '{RESERVING_TIMEOUT_SEC} seconds'
            """)
            res = await db.execute(stmt)
            reserving = res.fetchall()

        for pay_id, client_ref in reserving:
            data = await _check_alby_status_by_client_ref(client_ref)
            if data and data.get("id"):
                async with db.begin():
                    await db.execute(text("""
                        UPDATE payments SET invoice_id=:inv, payment_request=:pr, expires_at=:exp, state='open'
                        WHERE id=:id
                    """), {"inv": data.get("id"), "pr": data.get("payment_request"),
                           "exp": data.get("expires_at"), "id": pay_id})
            else:
                # FIX #MIT1-REC: Never delete. Mark dead for audit/boot recovery
                async with db.begin():
                    await db.execute(text("UPDATE payments SET state='dead' WHERE id=:id"), {"id": pay_id})
    finally:
        if own_db: await db.close()
