        updates = []
        for pay_id, client_ref in orphans:
            data = await _check_alby_status_by_client_ref(client_ref)
            if data and data.get("id"):
                updates.append((data.get("id"), data.get("payment_request"), data.get("expires_at"), pay_id))

        if updates:
            async with db.begin():
                for inv, pr, exp, pay_id in updates:
                    await db.execute(text("UPDATE payments SET invoice_id=:inv, payment_request=:pr, expires_at=:exp, state='open' WHERE id=:id"),
                                     {"inv": inv, "pr": pr, "exp": exp, "id": pay_id})
    finally:
