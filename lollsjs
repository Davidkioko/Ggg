async def check_overstay(db: AsyncSession):
    now = datetime.now(timezone.utc)
    grace = timedelta(seconds=OVERSTAY_MAX_SEC)
    window_end = now + grace
    BATCH = 200
    async with db.begin():
        res = await db.execute(select(User).where(User.package_end!= None, User.active_channel!= None, User.package_end <= window_end).order_by(User.package_end.asc()).limit(BATCH))
        users = res.scalars().all()
        for u in users:
            if u.package_end + grace <= now:
                chat_id = int(u.active_channel)
                await kick_with_fallback(app, chat_id, u.uid)
                kicked = await _verify_kick(chat_id, u.uid)
                if kicked:
                    await db.execute(update(User).where(User.uid==u.uid).values(active_package=None, active_channel=None, package_end=None))
