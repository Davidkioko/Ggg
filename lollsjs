async def check_gate_membership(bot, user_id: int) -> bool:
    """Verifies user entry channel subscription with fail-safe error handling."""
    try:
        member = await bot.get_chat_member(chat_id=DB["config"]["gate_channel"], user_id=user_id)
        if member.status in ['creator', 'administrator', 'member']:
            return True
    except Exception as e:
        ErrorLogger.log("GATE_CHECK_API_ERROR", f"Verification breakdown for user {user_id}", e)
    return False

async def nuke_all_messages(bot, chat_id: int, user_data: dict):
    """Executes Vanish Mode by cleanly wiping all past UI structural layout messages."""
    for msg_id in list(user_data["active_menu_ids"]):
        try:
            await bot.delete_message(chat_id=chat_id, message_id=msg_id)
        except Exception:
            pass  # Structural skip if message was manually purged or expired
    user_data["active_menu_ids"] = []

async def send_menu_template(bot, chat_id: int, text: str, reply_markup: InlineKeyboardMarkup, user_data: dict):
    """Drives structural canvas redraws across UI states with atomic cleanup rules."""
    await nuke_all_messages(bot, chat_id, user_data)
    try:
        msg = await bot.send_animation(
            chat_id=chat_id,
            animation=DB["config"]["promo_gif"],
            caption=text,
            reply_markup=reply_markup,
            parse_mode="Markdown"
        )
        user_data["active_menu_ids"].append(msg.message_id)
        user_data["last_interaction"] = datetime.utcnow()
    except TelegramError as e:
        ErrorLogger.log("UI_FRAME_SEND_CRITICAL", f"Canvas failure for chat {chat_id}", e)

