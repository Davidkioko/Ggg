    try:
        async with db.begin():
            stmt = text("SELECT id, client_ref FROM payments WHERE paid = false AND invoice_id IS NULL AND state = 'reserving' AND created > now() - interval '72 hours'") # FIX #MIT1D
            res = await db.execute(stmt)
