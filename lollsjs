async def _verify_kick(chat_id, uid, max_retries=3):
    now = datetime.now(timezone.utc)
    if uid in last_kick_check:
        if (now - last_kick_check[uid]).total_seconds() < 10:
            return False
    last_kick_check[uid] = now
    for i in range(max_retries):
        try:
            async with tg_semaphore:
                member = await app.get_chat_member(chat_id, uid)
            if member.status in ["left", "kicked"]:
                return True
        except Exception:
            await asyncio.sleep(2 ** i)
            continue
    return False

