@app.on_message(filters.private)
async def gate_check(client, m):
    uid = m.from_user.id
    passed_gate = await check_gate(client, uid)

    async with SessionLocal() as db:
        async with db.begin(): # FIX #51: ONE TX for create user + credit + verify + referrer + optional vanish
            u = await db.get(User, uid)
            is_new = False
            if not u:
                is_new = True
                tokens = await get_new_user_tokens(db=db) # FIX #A26: use same db session
                await add_tokens(uid, tokens, db=db) # FIX #A25: must use same db, no internal commit
                # FIX #50: UPDATE not mutation
                await db.execute(update(User).where(User.uid == uid).values(is_verified_gate1=True))
                u = await db.get(User, uid) # re-fetch for next check
            if is_new and m.text and m.text.startswith("/start ref_"):
                try:
                    ref_id = int(m.text.split("ref_")[1])
                    if ref_id!= uid:
                        # FIX #50: UPDATE not mutation, conditional to prevent overwrite
                        await db.execute(update(User).where(
                            User.uid == uid,
                            User.referred_by.is_(None)
                        ).values(referred_by=ref_id))
                except: pass

            if not passed_gate:
                # FIX #51: vanish must be part of same TX so it rolls back with user creation
                await _vanish_menus(client, uid, db=db)

        # commit auto at end of db.begin(). If any of the above fails, ALL rolls back

    # IO happens AFTER TX
    if not passed_gate:
        gate_name = _GATE_CACHE["value"] if _GATE_CACHE["value"] else "required channel"
        await send_message(client, m.chat.id, f"You left {gate_name}. Join to continue") # FIX #4: use wrapper
        return

    if m.text and m.text.startswith("/start"):
        async with SessionLocal() as db:
            await _vanish_menus(client, uid, db=db) # separate TX for normal /start
        balance = await get_balance(uid)
        photo = await get_gif("main")
        caption = main_menu(balance)
        # FIX #4: use wrapper for send_photo too
        async with tg_semaphore:
            await client.send_photo(chat_id=m.chat.id, photo=photo, caption=caption)
# END PART

