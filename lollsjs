CACHE_TTL_CHATMEM = 30 # FIX #5: was 5s, now 30s. Membership rarely changes

# PART: VANISH_ATOMIC
# HEADER: FIX #A25 Accept external db to keep vanish in caller's TX. FIX #A27: IO outside TX
async def _vanish_menus(client, uid, db=None):
    """Vanish logic: delete all stored menu_msg_ids. Always uses JSON string. Uses caller's TX, no nested begin"""
    own_db = False
    if db is None:
        db = SessionLocal()
        own_db = True
    ids_to_delete = []
    try:
        # FIX #52: No db.begin() here. Use caller's transaction to ensure atomicity
        u = await db.get(User, uid)
        if not u or not u.menu_msg_ids:
            if own_db:
                await db.commit() # commit read-only if we opened db
            return
        try:
            ids_to_delete = json.loads(u.menu_msg_ids)
        except json.JSONDecodeError:
            ids_to_delete = []
        u.menu_msg_ids = "[]" # FIX BUG 5: Always store as JSON string
        if own_db:
            await db.commit() # only commit if we own the session
        # FIX #A27: Do TG IO AFTER DB write so DB Tx can rollback independently
        if ids_to_delete:
            await batch_delete_messages(client, uid, ids_to_delete) # FIX #2: batch delete instead of 1-by-1
    finally:
        if own_db:
            await db.close()
# END PART

async def _get_cached_gate(db):
    # FIX #3: cache gate1_channel in memory for 1800s and resolve to numeric ID once
    now = time.time()
    if _GATE_CACHE["id"] and (now - _GATE_CACHE["ts"] < CACHE_TTL_GATE):
        return _GATE_CACHE["id"]
    gate = await db.get(Setting, "gate1_channel")
    val = gate.value if gate else None
    if val:
        try:
            # resolve once and cache numeric id
            async with tg_semaphore:
                chat = await app.get_chat(val)
                _GATE_CACHE["id"] = chat.id
        except:
            _GATE_CACHE["id"] = val # fallback to string if resolve fails
    _GATE_CACHE["value"] = val
    _GATE_CACHE["ts"] = now
    return _GATE_CACHE["id"]

async def check_gate(client, uid):
    # FIX #3: check cache before DB + TG API, use numeric id
    async with SessionLocal() as db:
        gate_id = await _get_cached_gate(db)
        if not gate_id: return False
    now = time.time()
    key = (gate_id, uid)
    if key in _CHATMEM_CACHE:
        status, ts = _CHATMEM_CACHE[key]
        if now - ts < CACHE_TTL_CHATMEM:
            return status in ["member", "administrator", "creator"]
    try:
        async with tg_semaphore: # FIX #3
            member = await client.get_chat_member(gate_id, uid)
        status = member.status
        _CHATMEM_CACHE[key] = (status, now)
        return status in ["member", "administrator", "creator"]
    except:
        _CHATMEM_CACHE[key] = ("left", now)
        return False

