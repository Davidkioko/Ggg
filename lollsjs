# --- Shared HTTP Session for Alby + Webhooks ---
# Reuse 1 TCP connection pool instead of creating new ClientSession per request
_http_session: aiohttp.ClientSession = None
async def get_http() -> aiohttp.ClientSession:
    global _http_session
    if _http_session is None or _http_session.closed:
        connector = aiohttp.TCPConnector(limit=200 if IS_PAID else 100, keepalive_timeout=30)
        _http_session = aiohttp.ClientSession(connector=connector, timeout=aiohttp.ClientTimeout(total=WEBHOOK_TIMEOUT))
