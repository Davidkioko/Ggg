# High-speed pricing layer cached for 12 hours to stay strictly below free-tier API rate limits.
BTC_PRICE_CACHE = {"price": 65000.0, "last_updated": None}

async def fetch_btc_price() -> float:
    """Fetches real-time Bitcoin pricing across a 3-layer infrastructure matrix."""
    now = datetime.utcnow()
    if BTC_PRICE_CACHE["last_updated"] and (now - BTC_PRICE_CACHE["last_updated"]) < timedelta(hours=12):
        return BTC_PRICE_CACHE["price"]

    # Layer 1: CoinGecko (Primary Outpost)
    try:
        async with httpx.AsyncClient() as client:
            res = await client.get("https://coingecko.com", timeout=4.0)
            if res.status_code == 200:
                price = float(res.json()["bitcoin"]["usd"])
                BTC_PRICE_CACHE.update({"price": price, "last_updated": now})
                return price
    except Exception as e:
        ErrorLogger.log("PRICE_COINGECKO_FAIL", "Rolling over to secondary endpoint", e)

    # Layer 2: Binance (First Backup Fallback)
    try:
        async with httpx.AsyncClient() as client:
            res = await client.get("https://binance.com", timeout=4.0)
            if res.status_code == 200:
                price = float(res.json()["price"])
                BTC_PRICE_CACHE.update({"price": price, "last_updated": now})
                return price
    except Exception as e:
        ErrorLogger.log("PRICE_BINANCE_FAIL", "Rolling over to tertiary endpoint", e)

    # Layer 3: Kraken (Final Defensive Fallback)
    try:
        async with httpx.AsyncClient() as client:
            res = await client.get("https://kraken.com", timeout=4.0)
            if res.status_code == 200:
                price = float(res.json()["result"]["XXBTZUSD"]["c"])
                BTC_PRICE_CACHE.update({"price": price, "last_updated": now})
                return price
    except Exception as e:
        ErrorLogger.log("PRICE_KRAKEN_FAIL", "All active REST pricing pipelines exhausted", e)
    
    return BTC_PRICE_CACHE["price"]  # Return old cached record to prevent bot crashes
