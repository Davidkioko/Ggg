# PART LABEL: Package buy Tx - ATOMIC
# HEADER: FIX #19 Wrap in db.begin() so all DB ops commit only at final line. FIX #52: side-effects after commit. FIX #53: side effect uses no db
# HEADER: FIX #OCC2 Read balance_version, update with version check, retry if rowcount 0. Single source of truth with add_tokens
# HEADER: FIX #OCC3 Add with_for_update to balance_version read to enforce row lock per spec
# HEADER: FIX #LIVE2 Use OCC_RETRIES with module-specific backoff 0.015-0.045*(2^retry) to break livelock and give package priority
# HEADER: FIX #STARVE1 Bump outer SERIALIZABLE retry attempts to OCC_RETRIES to reduce lock starvation aborts
# HEADER: FIX #JITTER2 Add jitter on every outer retry, not just 40001
# HEADER: FIX #LOG2 Log final OCC retry attempt for contention visibility
# HEADER: FIX #QUEUE2 Acquire per-uid lock for full duration to prevent concurrent add/deduct/activate
# HEADER: FIX #MITA-2.1-2.2 Lock order: TX first, then uid_lock. Call is_user_locked_for_buy inside TX
async def activate_package(db: AsyncSession = None, uid=None, key=None, active_channel=None):
    """Atomic token deduction + package activation + channel set. expiring_set updated after TX"""
    if not active_channel:
        return False

    own_db = False
    if db is None:
        db = SessionLocal()
        own_db = True

    p = PACKAGES[key]
    cost = p["cost"]
    success = False

    async def _activate_tx():
        nonlocal success
        max_attempts = OCC_RETRIES # FIX #MITA-5.2: was 5 hardcoded
        for attempt in range(max_attempts):
            # FIX #JITTER2: jitter before each retry attempt > 0
            if attempt > 0:
                await asyncio.sleep(random.uniform(0.03, 0.10))
            try:
                async with db.begin(): # FIX #MITA-2.1: TX first
                    await db.execute(select(1).execution_options(isolation_level="SERIALIZABLE"))

                    # FIX #MITA-2.2: Call lock check inside TX so it can do SELECT FOR UPDATE
                    from modules.payment_callbacks import is_user_locked_for_buy
                    if await is_user_locked_for_buy(uid, db):
                        success = False
                        break

                    uid_lock = await _get_uid_lock(uid) # FIX #MITA-2.1: then lock
                    async with uid_lock:
                        u = await db.execute(select(User).where(User.uid == uid).with_for_update())
                        u = u.scalar_one_or_none()
                        if not u:
                            success = False
                            break

                        now = datetime.now(timezone.utc)

                        # FIX #OCC2 + FIX #OCC3 + FIX #LIVE2: OCC loop for balance deduction with row lock
                        for retry in range(OCC_RETRIES): # FIX #MITA-5.2: was 4 hardcoded
                            if retry == OCC_RETRIES - 1: # FIX #LOG2
                                logger.warning("OCC contention: activate_package final retry attempt=%s for uid=%s key=%s", retry, uid, key)

                            res_ver = await db.execute(
                                select(User.balance_version, User.tokens)
                       .where(User.uid == uid)
                       .with_for_update() # FIX #OCC3: lock row so version can't change between read and update
                            )
                            row = res_ver.first()
                            if not row:
                                success = False
                                break
                            expected_version, current_tokens = row
                            if current_tokens < cost:
                                success = False
                                break

                            stmt = (
                                update(User)
                .where(User.uid == uid, User.tokens >= cost, User.active_channel.is_(None), User.balance_version == expected_version)
                .values(
                                    tokens=User.tokens - cost,
                                    balance_version=User.balance_version + 1, # FIX #OCC2
                                    active_package=key,
                                    active_channel=active_channel,
                                    package_end=now + timedelta(seconds=p["internal"])
                                )
                            )
                            res = await db.execute(stmt)
                            if res.rowcount == 1:
                                success = True
                                break
                            # rowcount 0 means version changed or tokens/ channel changed, re-read and retry
                            await asyncio.sleep(random.uniform(0.015 * (2 ** retry), 0.045 * (2 ** retry))) # FIX #LIVE2: module-specific range
                        else:
                            success = False

                        if not success:
                            break

                # FIX #52: Only update in-memory expiring set AFTER DB TX committed successfully
                # FIX #53: Do not pass db. If this crashes, DB is already committed. Cleaner will repopulate on boot
                if success:
                    await add_expiring_user(uid)
                return success

            except DBAPIError as e:
                if attempt < max_attempts - 1 and getattr(e.orig, 'pgcode', None) == '40001': # FIX #STARVE1
                    await asyncio.sleep(random.uniform(0.02, 0.08))
                    continue
                # FIX #JITTER2: jitter for any other retryable DBAPIError before outer loop continues
                if attempt < max_attempts - 1:
                    await asyncio.sleep(random.uniform(0.02, 0.08))
                    continue
                raise
        return False

    try:
        # PART 4: Apply retry_with_jitter to external DB TX
        return await retry_with_jitter(_activate_tx)
    finally:
        if own_db:
            await db.close()
# END PART

