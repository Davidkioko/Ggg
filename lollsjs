async def execute_package_generation(bot, user_id: int, user_data: dict, ch_idx: int):
    """Generates a secure one-time invite link and triggers immediate automated ejection workflows."""
    cost = user_data.pop("pending_cost", None)
    duration_mins = user_data.pop("pending_duration", None)
    
    if not cost or not duration_mins:
        user_data["processing_lock"] = False
        return

    target_channel = DB["config"]["premium_channels"][ch_idx]

    try:
        # Generate an single-use invitation link with an absolute temporal hard stop boundary
        link_obj = await bot.create_chat_invite_link(
            chat_id=target_channel["id"],
            member_limit=1,
            expire_date=datetime.utcnow() + timedelta(minutes=duration_mins)
        )
        
        # Deduct balance across structural fields
        if user_data["daily_referral_tokens"] >= cost:
            user_data["daily_referral_tokens"] -= cost
        else:
            remainder = cost - user_data["daily_referral_tokens"]
            user_data["daily_referral_tokens"] = 0
            user_data["tokens"] -= remainder

        # Establish package contract state parameters
        user_data["current_package"] = {
            "type": cost,
            "end_time": datetime.utcnow() + timedelta(minutes=duration_mins),
            "channel_id": target_channel["id"],
            "joined": False
        }

        user_data["processing_lock"] = False  # Safely lift deployment lock matrix

        keyboard = [[InlineKeyboardButton("🔗 Enter Premium Channel", url=link_obj.invite_link)]]
        text = (
            f"🎫 *Your One-Time Access Pass is Live!*\n\n"
            f"⚠️ *Important security alert:* Do not forward or share this invitation package. "
            f"It is mapped exclusively to your profile verification handshake and will brick immediately if transferred."
        )
        await send_menu_template(bot, user_id, text, InlineKeyboardMarkup(keyboard), user_data)
        
        # Deploy immediate isolated non-blocking microtask execution thread for absolute zero-delay kick processing
        asyncio.create_task(immediate_ejection_handler(bot, user_id, duration_mins, target_channel["id"]))

    except Exception as e:
        user_data["processing_lock"] = False
        ErrorLogger.log("SECURE_PROVISIONING_CRITICAL", f"Link deployment breakdown for client user {user_id}", e)
        await send_menu_template(bot, user_id, "⚠️ *An infrastructure timeout blocked secure path routing. Please retry execution.*", get_main_menu_markup(user_data), user_data)

async def immediate_ejection_handler(bot, user_id: int, delay_mins: int, channel_id: str):
    """Guarantees instant enforcement of subscription constraints independent of global polling delays."""
    await asyncio.sleep(delay_mins * 60)
    user_data = DB["users"].get(user_id)
    if not user_data:
        return
        
    user_data["current_package"] = None
    status_msg = "🚨 *Your Premium Access Session Has Expired!*"
    
    try:
        # Atomic ban and unban sequence forcefully drops active channel memberships cleanly
        await bot.ban_chat_member(chat_id=channel_id, user_id=user_id)
        await bot.unban_chat_member(chat_id=channel_id, user_id=user_id)
    except Exception as e:
        # Catch long channel member index lock anomalies and apply defensive overstay tolerance window
        ErrorLogger.log("EJECTION_INDEX_LOCK", f"Executing fallback 3-min queue for client {user_id}", e)
        await asyncio.sleep(180)  # Maximum 3-minute structural queue fallback buffer
        try:
            await bot.ban_chat_member(chat_id=channel_id, user_id=user_id)
            await bot.unban_chat_member(chat_id=channel_id, user_id=user_id)
            status_msg = "🚨 *Your Premium Access Session Has Expired!*"
        except Exception as retry_err:
            ErrorLogger.log("FALLBACK_EJECTION_FAIL", f"Hard block on member removal for user {user_id}", retry_err)
            status_msg = "⚠️ *Your Premium Session is Expiring Soon!*"

    # Forcibly wipe conversation canvas history completely
    await nuke_all_messages(bot, user_id, user_data)
    
    keyboard = [[InlineKeyboardButton("🚀 Get Access Duration", callback_data="MENU_ACCESS")]]
    await send_menu_template(bot, user_id, status_msg, InlineKeyboardMarkup(keyboard), user_data)
