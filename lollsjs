import logging
import asyncio
import random

logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
log = logging.getLogger("vipbot")

async def safe_call(fn, *args, retries=3, **kwargs):
    for i in range(retries):
        try:
            return await fn(*args, **kwargs) # make fn awaitable
        except Exception as e:
            log.error(f"Attempt {i+1}/{retries} failed: {e}")
            if i < retries - 1:
                # Bug #2: jitter backoff to avoid synchronized retries under FloodWait
                await asyncio.sleep(2 ** i + random.uniform(0, 1)) # 1s-2s, 2s-3s, 4s-5s non-blocking
    log.error(f"All {retries} attempts failed for {fn.__name__}")
    return None # MODULE 18/26 must check result before assuming success

async def retry_with_jitter(fn, *args, max_attempts=3, **kwargs):
    for i in range(max_attempts):
        try:
            return await fn(*args, **kwargs)
        except Exception:
            if i == max_attempts-1: raise
            await asyncio.sleep((2**i) + random.uniform(0.1, 0.5)) # jitter

