async def start_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Entry checkpoint routing. Manages deep-linked referral processing cleanly."""
    user_id = update.effective_user.id
    init_user(user_id)
    DB["daily_stats"]["active_users"].add(user_id)
    user_data = DB["users"][user_id]
    
    # Process potential inbound referral deep link tokens
    if context.args and context.args[0].startswith("ref_"):
        try:
            referrer_id = int(context.args[0].split("_")[1])
            if referrer_id != user_id and referrer_id in DB["users"]:
                if user_id not in DB["referrals"].get(referrer_id, []):
                    DB["referrals"].setdefault(referrer_id, []).append(user_id)
        except Exception as e:
            ErrorLogger.log("REFERRAL_DEEP_LINK_PARSE", "Failed to extract referrer identity", e)

    if await check_gate_membership(context.bot, user_id):
        # Apply referral bonuses safely upon successful 1st gate check
        for ref_id, guests in DB["referrals"].items():
            if user_id in guests and f"credited_{user_id}" not in DB["users"][ref_id]:
                DB["users"][ref_id]["tokens"] += 2
                DB["users"][ref_id]["daily_referral_tokens"] += 2
                DB["users"][ref_id]["total_lifetime_referral_tokens"] += 2
                DB["users"][ref_id][f"credited_{user_id}"] = True

        await send_menu_template(context.bot, user_id, "✨ *Welcome to VIP Club Access!*", get_main_menu_markup(user_data), user_data)
    else:
        await show_gate_error(context.bot, user_id, user_data)
