async def _get_price_config():
    now = time.time()
    if _PRICE_CACHE["price"] is not None and (now - _PRICE_CACHE["ts"] < CACHE_TTL_PRICE):
        return _PRICE_CACHE["price"], _PRICE_CACHE["tokens"]
    async with SessionLocal() as db:
        price_s = await db.get(Setting, "price_usd")
        tokens_s = await db.get(Setting, "tokens_per_usd")
        price = float(price_s.value) if price_s else 1.0
        tokens = int(tokens_s.value) if tokens_s else 100
    _PRICE_CACHE["price"] = price
    _PRICE_CACHE["tokens"] = tokens
    _PRICE_CACHE["ts"] = now
    return price, tokens

# PART: INVOICE_CREATE_ATOMIC
# HEADER: FIX #MIT1-2PC: DB-FIRST 2PC. INSERT reserving ON CONFLICT -> COMMIT -> CALL ALBY SYNC -> UPDATE open with rowcount check -> COMMIT. Void on fail
# HEADER: FIX #MITA-3.1 Never DELETE. Use state='voided' so uq_one_unpaid_invoice excludes it
async def create_invoice(uid):
    db = SessionLocal()
    try:
        price_usd, tokens_per_usd = await _get_price_config()
        amount_usd = price_usd
        client_ref = str(uuid.uuid4())
        now = datetime.now(timezone.utc)

        # 1. INSERT reserving row with ON CONFLICT and COMMIT. No advisory lock
        async with db.begin():
            stmt_ins = insert(Payment).values(
                uid=uid, paid=False, amount_usd=amount_usd, tokens=tokens_per_usd,
                client_ref=client_ref, created=now, state='reserving',
                invoice_id=None, payment_request=None, expires_at=None
            ).on_conflict_do_nothing(index_elements=['client_ref']).returning(Payment.id)
            res = await db.execute(stmt_ins)
            pay_id = res.scalar_one_or_none()

            if pay_id is None:
                # Conflict: fetch existing reserving/open row
                existing = await db.scalar(
                    select(Payment).where(Payment.client_ref == client_ref).with_for_update()
                )
                if existing:
                    if existing.state == 'open' and existing.payment_request:
                        return (existing.payment_request, existing.invoice_id, existing.amount_usd, existing.tokens)
                    pay_id = existing.id
                    client_ref = existing.client_ref

        # 2. CALL ALBY SYNCHRONOUSLY outside TX
        s = await get_http()
        try:
            async with alby_semaphore:
                r = await s.post("https://api.getalby.com/invoices",
                                 headers={"Authorization": f"Bearer {ALBY_TOKEN}",
                                          "X-Idempotency-Key": client_ref},
                                 json={"amount": amount_usd,
                                       "metadata": {"uid": uid, "tokens": tokens_per_usd, "client_ref": client_ref}})
            if r.status >= 400:
                raise RuntimeError(f"Alby invoice creation failed status {r.status}")
            data = await r.json()
        except Exception:
            # 3a. If Alby fails, VOID the reserving row instead of DELETE per 3.1
            async with db.begin():
                await db.execute(text("UPDATE payments SET state='voided' WHERE id=:id AND state='reserving'"), {"id": pay_id})
            raise

        # 3b. If success, UPDATE to open with state='reserving' AND invoice_id IS NULL check
        async with db.begin():
            res_upd = await db.execute(text("""
                UPDATE payments SET state='open', invoice_id=:inv, payment_request=:pr, expires_at=:exp
                WHERE id=:id AND state='reserving' AND invoice_id IS NULL
                RETURNING id
            """), {"inv": data["id"], "pr": data["payment_request"], "exp": data["expires_at"], "id": pay_id})
            
            if res_upd.rowcount == 0:
                # FIX #MIT1-17B2: Webhook already filled it. Return DB state
                existing = await db.scalar(select(Payment).where(Payment.id == pay_id))
                return (existing.payment_request, existing.invoice_id, existing.amount_usd, existing.tokens)

        return (data["payment_request"], data["id"], amount_usd, tokens_per_usd)
    finally:
        await db.close()
