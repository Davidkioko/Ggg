async def admin_set_gate(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Dynamically locks the 1st Gate entrance requirement channel username."""
    if update.effective_user.id != DB["config"]["admin_id"]: return
    if context.args:
        DB["config"]["gate_channel"] = context.args[0]
        await update.message.reply_text(f"🎯 1st Gate Channel set to: {context.args[0]}")

async def admin_set_premium(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """
    Configures premium channel destinations. Supports up to 2 unique streams.
    Usage: /setpremium -10012345 ChannelTitle_1 [-10067890 ChannelTitle_2]
    """
    if update.effective_user.id != DB["config"]["admin_id"]: return
    if len(context.args) >= 2:
        channels = [{"id": context.args[0], "title": context.args[1]}]
        if len(context.args) >= 4:
            channels.append({"id": context.args[2], "title": context.args[3]})
        DB["config"]["premium_channels"] = channels[:2]
        await update.message.reply_text(f"📺 Sync complete. Active Premium Matrix: {DB['config']['premium_channels']}")

async def admin_add_token(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Overwrites user balances manually to fix payment execution drops or exceptions."""
    if update.effective_user.id != DB["config"]["admin_id"]: return
    if len(context.args) == 2:
        try:
            t_user, amt = int(context.args[0]), int(context.args[1])
            init_user(t_user)
            DB["users"][t_user]["tokens"] += amt
            await update.message.reply_text(f"🪙 Credited {amt} tokens to profile UID: `{t_user}`")
        except ValueError:
            pass

async def admin_earnings(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Outputs immediate financial performance metrics and platform retention metrics."""
    if update.effective_user.id != DB["config"]["admin_id"]: return
    report = (
        f"📊 *Administrative Ledger Report:*\n\n"
        f"👥 Unique Active Daily Accounts: *{len(DB['daily_stats']['active_users'])}*\n"
        f"💰 Daily Vault Intake: *${DB['daily_stats']['earnings_usd']:.2f} USD*\n"
        f"📈 Total Historical Lifetime Earnings: *${DB['global_earnings_usd']:.2f} USD*"
    )
    await update.message.reply_text(report, parse_mode="Markdown")

async def admin_post(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Broadcasts configured VIP marketing banners into designated channels on-click."""
    if update.effective_user.id != DB["config"]["admin_id"]: return
    if context.args:
        target = context.args[0]
        try:
            await context.bot.send_animation(
                chat_id=target,
                animation=DB["config"]["promo_gif"],
                caption=DB["config"]["default_post"],
                parse_mode="Markdown"
            )
            await update.message.reply_text("🚀 Campaign broadcast successfully deployed.")
        except Exception as e:
            await update.message.reply_text(f"❌ Broadcast route dropped: {e}")

